{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Init",
            "type": "shell",
            "command": "./init.sh",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "./run.sh",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Database Migration",
            "type": "shell",
            "command": "./migrate.sh",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Webserver Shell",
            "type": "shell",
            "command": "./webserver-shell.sh",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Docker Shell",
            "type": "shell",
            "command": "./docker-shell.sh ${input:ContainerName}",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": true,
                "clear": false
            }
        },
    ],
    "inputs": [
        {
            "id": "ContainerName",
            "description": "The Name of the Container you want to start a shell in.",
            "default": "stura-website-extern-web-1",
            "type": "promptString"
        },
    ],
}