<header class="container-fluid">
<nav class="navbar bg-primary navbar-expand-md fixed-top">
  <div class="container">
    <a class="navbar-brand" href=<%=root_url%>><%= image_tag "logo-mit-htwd-weiss.png", height: 30, alt: "Stura HTW" %></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <%= link_to "Home", root_path, method: "get", class: "nav-link" %>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Articles
          </a>
          <ul class="dropdown-menu">
            <li><%= link_to "All Articles", articles_path, method: "get", class: "dropdown-item" %></li>
            <li><hr class="dropdown-divider"></li>
            <% ArticleCategory.all.each do |category| %>
                <li><%= link_to category.name, article_category_articles_path(category.id), method: "get", class: "dropdown-item" %></li>
            <% end %>
          </ul>
        </li>
        <li class="nav-item">
          <%= link_to "Events", events_path, method: "get", class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Contact", contact_path, method: "get", class: "nav-link" %>
        </li>
        <% if logged_in? %>
            <li class="nav-item">
              <%= link_to "Backend", backend_root_path, method: "get", class: "nav-link" %>
            </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
</header>