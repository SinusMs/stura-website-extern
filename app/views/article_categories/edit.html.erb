<% content_for :title, "Artikelkategorie bearbeiten" %>

<div class="container section-light">
  <h1 class="mt-3">Artikelkategorie bearbeiten</h1>

  <%= render "form", article_category: @article_category %>
</div>

<div class="container my-3 d-flex gap-3 flex-wrap">
  <%= button_to "Artikelkategorien anzeigen", article_categories_path, method: :get, class: "btn btn-secondary" %>
  <%= button_to "Artikelkategorie Löschen", @article_category, method: :delete, class: "btn btn-secondary", form: {data: {turbo_confirm: "WARNUNG: Diese Aktion kann nicht rückgängig gemacht werden!"}} %>
</div>