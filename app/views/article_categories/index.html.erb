<% content_for :title, "Article categories" %>

<div class="container section-light">
  <h1 class="mt-3">Artikelkategorien</h1>

  <table class="table w-auto" id="article_categories">
    <thead>
      <tr>
        <th>Name</th>
        <th>Aktiv</th>
        <th>Bearbeiten</th>
      </tr>
    </thead>
    <tbody>
      <% @article_categories.each do |article_category| %>
        <tr>
          <td><%= article_category.name %></td>
          <td><%= article_category.enabled ? "Ja" : "Nein" %></td>
          <td><%= link_to "Bearbeiten", edit_article_category_path(article_category) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="container my-3 d-flex gap-3 flex-wrap">
  <%= button_to "Artikelkategorie erstellen", new_article_category_path, method: :get, class: "btn btn-secondary" %>
</div>
