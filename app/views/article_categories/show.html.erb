<div class="container section-light">
  <%= render @article_category %>

  <div>
    <%= button_to "Bearbeiten", edit_article_category_path(@article_category), method: :get, class: "btn btn-secondary my-1" %>
    <%= button_to "Alle Artikelkategorien", article_categories_path, method: :get, class: "btn btn-secondary my-1" %>

    <%= button_to "Löschen", @article_category, method: :delete, class: "btn btn-secondary my-1" %>
  </div>
</div>