<div id="<%= dom_id article %>">
  <h1 class="m-0">
    <%= article.title %>
  </h1>

  <div class="d-flex gap-2">
    <%= article.published.try(:strftime, "%d.%m.%y") %>
    <i><%= ArticleCategory.find(article.article_category_id).name %></i>
  </div>

  <% if logged_in? %>
    <% if article.prioritize_until != nil and article.prioritize_until >= Time.now %>
      <strong>Priorisiert:</strong> Ja <br>
    <% else %>
      <strong>Priorisiert:</strong> Nein <br>
    <% end %>

    <% if article.prioritize_until != nil %>
      <strong>Priorisiert bis: </strong>
      <%= article.prioritize_until.try(:strftime, "%d.%m.%y %H:%M") %>
    <% end %>
  <% end %>

  <% if article.image.attached? %>
    <div class="mt-3">
      <%= image_tag article.image, class: "img-fluid" %>
    </div>
  <% end %>

  <p class="text-wrap text-break mt-4">
    <%= article.content %>
  </p>
</div>
