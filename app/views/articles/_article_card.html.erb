<%= link_to article_card, class: "text-decoration-none text-reset h-100" do %>
  <div id="<%= dom_id article_card %>" class="card <%= "card-prioritized" if article_card.prioritized? %> h-100 d-flex flex-column">
    <% if article_card.image.attached? %>
      <div class="card-img-top flex-grow-1 d-flex overflow-hidden">
        <%= image_tag article_card.image, class: "object-fit-cover flex-grow-1 d-block", alt: dom_id(article_card) + "_image" %>
      </div>
    <% end %>
    <div class="card-body flex-shrink-0">
      <h6 class="card-subtitle text-muted font-weight-light">
        <%= article_card.published.try(:strftime, "%d.%m.%y") %> <%= ArticleCategory.find(article_card.article_category_id).name %>
      </h6>
      <h5 class="card-title"><%= article_card.title %></h5>
      <p class="card-text text-truncate"><%= truncate(article_card.content, length: 100, separator: ' ') %></p>
    </div>
  </div>
<% end %>