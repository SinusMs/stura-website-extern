<div id="<%= dom_id article_preview %>">
  <h5 class="m-0 font-weight-light"><%= article_preview.title %> </h5>
  <div class="d-flex gap-2">
    <%= article_preview.published.try(:strftime, "%d.%m.%y") %>
    <i><%= ArticleCategory.find(article_preview.article_category_id).name %></i>
  </div>
  <%= link_to "Artikel anzeigen", article_preview %>
</div>
