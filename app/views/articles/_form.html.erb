<%= form_with(model: article, class: "needs-validation", local: true) do |form| %>
  <% if article.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading"><%= pluralize(article.errors.count, "error") %> prohibited this article from being saved:</h4>
      <ul class="mb-0">
        <% article.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, "Titel", class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :published, "Veröffentlichung", class: "form-label" %>
    <%= form.datetime_field :published, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :prioritize_until, "Priorisieren bis", class: "form-label" %>
    <%= form.datetime_field :prioritize_until, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :content, "Inhalt", class: "form-label" %>
    <%= form.text_area :content, class: "form-control", rows: 30 %>
  </div>

  <div class="mb-3">
    <%= form.label :article_category_id, "Kategorie", class: "form-label" %>
    <%= form.select :article_category_id,
        options_from_collection_for_select(ArticleCategory.all, "id", "name"),
        {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.submit "Speichern", class: "btn btn-secondary btn-lg" %>
  </div>
<% end %>
