<%= form_with(model: article, local: true) do |form| %>
  <% article.errors.full_messages_for(:base).each do |msg| %>
    <h5 class="alert-heading"><%= msg %></h5>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control #{'is-invalid' if article.errors[:title].any?}" %>
    <% article.errors.full_messages_for(:title).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>

<div class="mb-3 row justify-content-between">
  <div class="col-6 col-md-4 mb-3 mb-md-0">
    <%= form.label :published_day, class: "form-label" %>
    <%= form.date_field :published_day, class: "form-control #{'is-invalid' if article.errors[:published].any? || article.errors[:published_day].any?}" %>
    <% article.errors.full_messages_for(:published).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
    <% article.errors.full_messages_for(:published_day).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>

  <div class="col-6 col-md-4 mb-3 mb-md-0">
    <%= form.label :published_time, class: "form-label" %>
    <%= form.time_field :published_time, class: "form-control #{'is-invalid' if article.errors[:published_time].any?}" %>
    <% article.errors.full_messages_for(:published_time).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>

  <div class="col-12 col-md-4">
    <%= form.label :prioritize_until, class: "form-label" %>
    <%= form.date_field :prioritize_until, class: "form-control #{'is-invalid' if article.errors[:prioritize_until].any?}" %>
    <% article.errors.full_messages_for(:prioritize_until).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>
</div>

  <div class="mb-3">
    <%= form.label :content, class: "form-label" %>
    <%= form.text_area :content, class: "form-control #{'is-invalid' if article.errors[:content].any?}", rows: 30 %>
    <div class="form-text">Formatierung mittels Markdown wird unterstützt.</div>
    <% article.errors.full_messages_for(:content).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :article_category_id, class: "form-label" %>
    <%= form.select :article_category_id,
        options_from_collection_for_select(ArticleCategory.all, "id", "name"),
        {}, class: "form-select #{'is-invalid' if article.errors[:article_category_id].any?}" %>
    <% article.errors.full_messages_for(:article_category_id).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :image, class: "form-label" %>
    <%= form.file_field :image, class: "form-control #{'is-invalid' if article.errors[:image].any?}" %>
    <% article.errors.full_messages_for(:image).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>

  <% if article.persisted? && article.image.attached? %>
    <div class="mb-3">
      <%= image_tag article.image, class: "img-fluid" %>
    </div>
  <% end %>

  <div>
    <%= form.submit "Speichern", class: "btn btn-secondary btn-lg" %>
  </div>
<% end %>
