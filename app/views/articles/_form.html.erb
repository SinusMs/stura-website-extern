<%= form_with(model: article) do |form| %>
  <% if article.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(article.errors.count, "error") %> prohibited this article from being saved:</h2>

      <ul>
        <% article.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :published, style: "display: block" %>
    <%= form.datetime_field :published %>
  </div>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.label :article_category_id, style: "display: block" %>
    <%= form.select :article_category_id, options_from_collection_for_select(ArticleCategory.all, "id", "name") %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
