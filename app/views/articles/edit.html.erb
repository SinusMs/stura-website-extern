<% content_for :title, "Artikel bearbeiten" %>
<div class="container section-light">
  <h1 class="mt-3">Artikel bearbeiten</h1>

  <%= render "form", article: @article %>
</div>

<div class="container my-3 d-flex gap-3 flex-wrap">
  <%= button_to "Artikelübersicht", articles_path, method: :get, class: "btn btn-secondary" %>
  <%= button_to "Artikel Löschen", @article, method: :delete, class: "btn btn-secondary" %>
</div>