<% if @article_category == nil %>
  <% content_for :title, "Articles" %>
  <h1>Articles</h1>
<% else %>
  <% content_for :title, @article_category.name %>
  <h1>Article Category: <%= @article_category.name %></h1>
<% end %>


<div id="articles">
  <% @articles.each do |article| %>
    <%= render partial: "article_preview", object: article %>
  <% end %>
</div>