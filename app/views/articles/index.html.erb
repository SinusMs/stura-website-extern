<% if @articles.any? { |article| article.prioritize_until != nil and article.prioritize_until >= Time.current } %>
  <div class="overflow-y-hidden pt-5 pb-3 section-dark">
<% else %>
  <div class="overflow-y-hidden pt-5 pb-3 section-light">
<% end %>
  <div class="container">
    <% if @article_category == nil %>
      <% content_for :title, "Alle Artikel" %>
      <h1>Alle Artikel</h1>
    <% else %>
      <% content_for :title, @article_category.name %>
      <h1><%= @article_category.name %></h1>
    <% end %>
  </div>

  <% if logged_in? %>
    <div class="container my-3 d-flex gap-3 flex-wrap">
      <%= link_to "Artikel erstellen", new_article_path, method: :get, class: "btn btn-secondary"  %>
    </div>
  <% end %>
</div>

<% if @articles.any?(&:prioritized?) %>
  <div class="overflow-y-hidden pb-4 section-dark">
    <div id="prioritized_articles" class="container">
      <div class="row row-cols-md-2 justify-content-center">
        <% @articles.select(&:prioritized?).each do |article| %>
          <div class="col mb-4">
            <%= render partial: "article_card", object: article %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<% if @articles.any? { |article| !article.prioritized? } %>
  <div class="overflow-y-hidden pb-5 <%= "pt-5" if @articles.any?(&:prioritized?) %> section-light">
    <div id="articles" class="container">
      <div class="row row-cols-lg-3 justify-content-center">
        <% @articles.reject(&:prioritized?).each do |article| %>
          <div class="col mb-4">
            <%= render partial: "article_card", object: article %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>