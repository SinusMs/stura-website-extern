<% if @articles.any? { |article| article.prioritize_until != nil and article.prioritize_until >= Time.now } %>
  <div class="overflow-y-hidden py-4 section-dark">
<% else %>
  <div class="overflow-y-hidden py-4 section-light">
<% end %>
  <div class="container">
    <% if @article_category == nil %>
      <% content_for :title, "Alle Artikel" %>
      <h1>Alle Artikel</h1>
    <% else %>
      <% content_for :title, @article_category.name %>
      <h1><%= @article_category.name %></h1>
    <% end %>
  </div>
</div>

<% if logged_in? %>
  <div class="container my-3 d-flex gap-3 flex-wrap">
    <%= link_to "Artikel erstellen", new_article_path, method: :get, class: "btn btn-secondary"  %>
  </div>
<% end %>

<div id="articles">
  <% @articles.each do |article| %>
    <%= render partial: "article_preview", object: article, layout: (article.prioritize_until == nil or article.prioritize_until < Time.now) ? "layouts/section-light" : "layouts/section-dark" %>
  <% end %>
</div>