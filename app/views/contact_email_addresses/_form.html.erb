<%= form_with(model: contact_email_address, class: "needs-validation", local: true) do |form| %>
  <% if contact_email_address.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading"><%= pluralize(contact_email_address.errors.count, "error") %> prohibited this contact_email_address from being saved:</h4>
      <ul class="mb-0">
        <% contact_email_address.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, "Bezeichnung", class: "form-label" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :email_address, "E-Mail Adresse", class: "form-label" %>
    <%= form.text_field :email_address, class: "form-control" %>
  </div>

  <div>
    <%= form.submit "Speichern", class: "btn btn-secondary btn-lg mb-3" %>
  </div>
<% end %>
