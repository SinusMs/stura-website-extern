<p style="color: green"><%= notice %></p>

<% content_for :title, "Contact email addresses" %>

<h1>Contact email addresses</h1>

<div id="contact_email_addresses">
  <% @contact_email_addresses.each do |contact_email_address| %>
    <%= render contact_email_address %>
    <p>
      <%= link_to "Show this contact email address", contact_email_address %>
    </p>
  <% end %>
</div>

<%= link_to "New contact email address", new_contact_email_address_path %>
