<div class="container section-light">
  <%= render @contact_email_address %>

  <div>
    <%= button_to "Bearbeiten", edit_contact_email_address_path(@contact_email_address), method: :get, class: "btn btn-secondary btn-lg my-3" %>
    <%= button_to "Löschen", @contact_email_address, method: :delete, class: "btn btn-secondary btn-lg my-3" %>
    <%= button_to "Alle Kontakt-Email-Adressen", contact_email_addresses_path, method: :get, class: "btn btn-secondary btn-lg my-3" %>
  </div>
</div>