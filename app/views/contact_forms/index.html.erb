<h1>Contact Form</h1>
<%= form_with do |form| %>
    Send Contact Request to:
    <%= form.select :contact_email_address_id, options_from_collection_for_select(ContactEmailAddress.all, "id", "name") %><br>
    Your Request:
    <%= form.text_field :text %><br>
    Your Email Address:
    <%= form.email_field :your_email %><br>
    <%= form.submit "Send" %><br>
    <%= notice %><br>
<% end %>