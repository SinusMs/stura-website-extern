<%= form_with(model: event, local: true) do |form| %>
  <% event.errors.full_messages_for(:base).each do |msg| %>
    <h5 class="alert-heading"><%= msg %></h5>
  <% end %>

  <div class="mb-3">
    <%= form.label :datetime, "Zeit", class: "form-label" %>
    <%= form.datetime_field :datetime, class: "form-control #{'is-invalid' if event.errors[:datetime].any?}" %>
    <% event.errors.full_messages_for(:datetime).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :title, "Titel", class: "form-label" %>
    <%= form.text_field :title, class: "form-control #{'is-invalid' if event.errors[:title].any?}" %>
    <% event.errors.full_messages_for(:title).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Beschreibung", class: "form-label" %>
    <%= form.text_area :description, class: "form-control #{'is-invalid' if event.errors[:description].any?}", rows: 4 %>
    <% event.errors.full_messages_for(:description).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>

  <div class="mb-3 form-check form-switch">
    <%= form.check_box :is_session, class: "form-check-input event-check", id: "event_is_session" %>
    <%= form.label :is_session, "Sitzung", class: "form-check-label", for: "event_is_session" %>
  </div>

  <div class="mb-3">
    <%= form.label :location, "Ort", class: "form-label" %>
    <%= form.text_field :location, class: "form-control #{'is-invalid' if event.errors[:location].any?}" %>
    <% event.errors.full_messages_for(:location).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>

  <div>
    <%= form.submit "Speichern", class: "btn btn-secondary btn-lg" %>
  </div>
<% end %>
