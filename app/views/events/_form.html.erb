<%= form_with(model: event, class: "needs-validation", local: true) do |form| %>
  <% if event.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading"><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h4>
      <ul class="mb-0">
        <% event.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :datetime, "Zeit", class: "form-label" %>
    <%= form.datetime_field :datetime, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :title, "Titel", class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Beschreibung", class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 4 %>
  </div>

  <div class="mb-3 form-check form-switch">
    <%= form.check_box :is_session, class: "form-check-input event-check", id: "event_is_session" %>
    <%= form.label :is_session, "Sitzung", class: "form-check-label", for: "event_is_session" %>
  </div>

  <div class="mb-3">
    <%= form.label :location, "Ort", class: "form-label" %>
    <%= form.text_field :location, class: "form-control" %>
  </div>

  <div>
    <%= form.submit "Speichern", class: "btn btn-secondary btn-lg" %>
  </div>
<% end %>
