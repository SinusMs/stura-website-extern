<div class="container section-light">
  <h1 class="mt-3">Veranstaltung bearbeiten</h1>

  <%= render "form", event: @event %>
</div>

<div class="container my-3 d-flex gap-3 flex-wrap">
  <%= button_to "Veranstaltungsübersicht", events_path, method: :get, class: "btn btn-secondary" %>
  <%= button_to "Veranstaltung Löschen", @event, method: :delete, class: "btn btn-secondary", form: {data: {turbo_confirm: "WARNUNG: Diese Aktion kann nicht rückgängig gemacht werden!"}} %>
</div>