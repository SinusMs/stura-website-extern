<p style="color: green"><%= notice %></p>

<h1>Events</h1>

<div id="events">
  <button onclick="toggleRowVisibility()">Show/Hide Sessions</button>
  <table>
      <thead>
        <th>Date</th> <th>Time</th> <th>Event</th>
        <% if logged_in? %>
          <th>Edit</th> <th>Delete</th>
        <% end %>
      </thead>
      <tbody>
        <% @events.each do |event| %>
        <% if event.is_session %>
          <tr class="session-row" style="display: none;">
        <% else %>
          <tr class="event-row">
        <% end %>
            <td><%= event.datetime.strftime("%d.%m.%y") %></td>
            <td><%= event.datetime.strftime("%H:%M") %></td>
            <td><%= link_to event.title, event %></td>
            <% if logged_in? %>
                <td><%= button_to "Edit", edit_event_path(event), method: :get %></td>
                <td><%= button_to "Delete", event, method: :delete %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
  </table>
</div>

<script>  
  function toggleRowVisibility() {
      var hiddenRows = document.getElementsByClassName("session-row")
      for(var i=0, len=hiddenRows.length; i<len; i++){
        if (hiddenRows[i].style.display === "none") {
          hiddenRows[i].style.display = "";
        } else {
          hiddenRows[i].style.display = "none";
        }
      }
  }
</script>