<div class="overflow-y-hidden py-4 section-light">
  <div class="container text-center">
    <h1>Kalender</h1>

    <div id="events">
      <div class="d-flex flex-column align-items-center">
      <div class="form-check form-switch w-auto text-start" style="min-width: 250px;">
        <label class="form-check-label" for="events-checkbox">Veranstaltungen anzeigen</label>
        <input class="form-check-input event-check" type="checkbox" onclick="toggleRowVisibility()" id="events-checkbox" checked>
      </div>
      <div class="form-check form-switch w-auto text-start" style="min-width: 250px;">
        <label class="form-check-label" for="sessions-checkbox">Sitzungen anzeigen</label>
        <input class="form-check-input session-check" type="checkbox" onclick="toggleRowVisibility()" id="sessions-checkbox">
      </div>
      </div>
      <table class="table table-hover table-borderless w-auto mx-auto">
        <thead>
          <th>Datum</th> <th>Uhrzeit</th> <th class="text-start">Veranstaltung</th> <th>Ort</th>
          <% if logged_in? %>
            <th>Bearbeiten</th>
          <% end %>
        </thead>
        <tbody>
          <% @events.each do |event| %>
            <% if event.is_session %>
              <tr class="session-row" style="display: none;">
            <% else %>
              <tr class="event-row">
            <% end %>
                <td><%= event.datetime.try(:strftime, "%d.%m.%y") %></td>
                <td><%= event.datetime.try(:strftime, "%H:%M") %></td>
                <td class="text-start"><%= link_to event.title, event %></td>
                <td><%= event.location %></td>
                <% if logged_in? %>
                  <td><%= link_to "Bearbeiten", edit_event_path(event), method: :get %></td>
                <% end %>
              </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if logged_in? %>
  <div class="container my-3 d-flex gap-3 flex-wrap">
    <%= link_to "Veranstaltung erstellen", new_event_path, method: :get, class: "btn btn-secondary"  %>
  </div>
<% end %>

<script>  
  function toggleRowVisibility() {
      var sessionRows = document.getElementsByClassName("session-row");
      var sessionsCheckbox = document.getElementById("sessions-checkbox");
      for(var i=0, len=sessionRows.length; i<len; i++){
        if (sessionsCheckbox.checked == true) {
          sessionRows[i].style.display = "";
        } else {
          sessionRows[i].style.display = "none";
        }
      }

      var eventRows = document.getElementsByClassName("event-row");
      var eventsCheckbox = document.getElementById("events-checkbox");
      for(var i=0, len=eventRows.length; i<len; i++){
        if (eventsCheckbox.checked == true) {
          eventRows[i].style.display = "";
        } else {
          eventRows[i].style.display = "none";
        }
      }
  }

  // necessary to match row visibilities with checkbox states after page reload
  document.addEventListener("DOMContentLoaded", function () {
    toggleRowVisibility();
  });
</script>