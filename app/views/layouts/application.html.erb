<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "StuRa Website" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= content_for?(:head) ?  yield(:head) : nil %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "popper", "data-turbo-track": "reload", defer: true  %>
    <%= javascript_include_tag "bootstrap.min", "data-turbo-track": "reload", defer: true  %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <%= render "main_menu" %>
    <%= content_for?(:backend_menu) ? yield(:backend_menu) : nil  %>
    <main class="mt-5 flex-grow-1">
    <%= yield %>
    </main>
    <%= render "footer" %>
  </body>
</html>
