<div class="section-light d-flex flex-column justify-content-center text-center form-signin m-auto mt-5" style="max-width: 320px">
    <h1>Anmelden</h1>
    <%= form_with url: login_path do |form| %>
        <div class="form-floating m-3">
            <%= form.text_field :username, placeholder: "", class: "form-control" %>
            <%= form.label :username, "Nutzername" %>
        </div>
        <div class="form-floating m-3">
            <%= form.password_field :password, placeholder: "",  class: "form-control" %>
            <%= form.label :password, "Passwort" %>
        </div>
        <div>
            <%= link_to "Logindaten vergessen?", forgot_password_path %>
        </div>
            <%= form.submit "Anmelden", id: "login", class: "btn btn-secondary btn-lg my-3" %>
    <% end %>
</div>