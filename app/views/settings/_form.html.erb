<%= form_with(model: setting, url: settings_url, class: "needs-validation", local: true) do |form| %>
  <% if setting.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading"><%= pluralize(setting.errors.count, "error") %> prohibited this setting from being saved:</h4>
      <ul class="mb-0">
        <% setting.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :showArticlesForDays, "Zeige Artikel für x Tage ab Veröffentlichung", class: "form-label" %>
    <%= form.number_field :showArticlesForDays, class: "form-control" %>
  </div>

  <div>
    <%= form.submit "Speichern", class: "btn btn-secondary btn-lg" %>
  </div>
<% end %>
