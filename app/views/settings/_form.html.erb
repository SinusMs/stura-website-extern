<%= form_with(model: setting, url: settings_url, local: true) do |form| %>
  <% setting.errors.full_messages_for(:base).each do |msg| %>
    <h5 class="alert-heading"><%= msg %></h5>
  <% end %>

  <div class="mb-3">
    <%= form.label :showArticlesForDays, class: "form-label" %>
    <%= form.number_field :showArticlesForDays, class: "form-control #{'is-invalid' if setting.errors[:showArticlesForDays].any?}" %>
    <% setting.errors.full_messages_for(:showArticlesForDays).each do |msg| %>
      <div class="invalid-feedback"><%= msg %></div>
    <% end %>
  </div>

  <div>
    <%= form.submit "Speichern", class: "btn btn-secondary btn-lg" %>
  </div>
<% end %>
