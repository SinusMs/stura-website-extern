<% if @reset_password_code.is_activation_code %>
  <h1 style="color: #FFD6BA;"><%= "Aktiviere deinen Account, #{@user.username}!" %></h1>
<% else %>
  <h1 style="color: #FFD6BA;"><%= "Zurücksetzungslink für deinen Account, #{@user.username}!" %></h1>
<% end %>

<p style="color: white;">
  <%= link_to "Hier klicken, um Nutzernamen und Passwort festzulegen.", reset_password_url(@reset_password_code.code), style: "color: white; text-decoration: underline;" %><br><br>
  Dieser Link läuft in <%= @reset_password_code.is_activation_code ? ENV.fetch("ACCOUNT_ACTIVATION_CODE_VALIDITY_DAYS", 14) + " Tagen" : ENV.fetch("RESET_PASSWORD_CODE_VALIDITY_MINUTES", 30) + " Minuten" %> ab.
</p>