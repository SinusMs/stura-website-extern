<% if @reset_password_code.is_activation_code %>
  <h1 style="color: #FFD6BA;"><%= "Aktiviere deinen Account, #{@user.username}!" %></h1>
<% else %>
  <h1 style="color: #FFD6BA;"><%= "Zurücksetzungslink für deinen Account, #{@user.username}!" %></h1>
<% end %>

<p>
  <%= link_to "Hier klicken, um Nutzernamen und Passwort festzulegen.", reset_password_url(@reset_password_code.code), style: "color: white;" %>
</p>