<% if @reset_password_code.is_activation_code %>
<%= "Aktiviere deinen Account, #{@user.username}!" %>
<% else %>
<%= "Zurücksetzungslink für deinen Account, #{@user.username}!" %>
<% end %>

<%= reset_password_url(@reset_password_code.code) %>

Dieser Link läuft in <%= @reset_password_code.is_activation_code ? ENV.fetch("ACCOUNT_ACTIVATION_CODE_VALIDITY_DAYS", 14) + " Tagen" : ENV.fetch("RESET_PASSWORD_CODE_VALIDITY_MINUTES", 30) + " Minuten" %> ab.