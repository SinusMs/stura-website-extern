<div class="container py-4 section-light">
    <h1>Nutzereinstellungen (<%= @user.email_address %>)</h1>

    <%= render "form", user: @user %>

    <% if @user == current_user %>
        <%= button_to "Passwort zurücksetzen", reset_password_request_path(@user), method: :put, class: "btn btn-secondary btn-lg my-3" %>
        <%= button_to "ACCOUNT LÖSCHEN", @user, method: :delete, class: "btn btn-secondary btn-lg my-3" %>
    <% elsif is_admin? %>
        <%= button_to "Zurücksetungslink an Nutzer senden", reset_password_request_path(@user), method: :put, class: "btn btn-secondary btn-lg my-3" %>
        <%= button_to "Nutzer Löschen", @user, method: :delete, class: "btn btn-secondary btn-lg my-3" %>
    <% end %>
</div>