<div class="container section-light">
  <h1 class="mt-3">Nutzereinstellungen (<%= @user.email_address %>)</h1>

  <%= render "form", user: @user %>
</div>

<div class="container my-3 d-flex gap-3 flex-wrap">
  <% if is_admin? %>
    <%= button_to "Nutzerübersicht", users_path, method: :get, class: "btn btn-secondary" %>
  <% end %>
  <% if @user == current_user %>
    <%= button_to "Passwort zurücksetzen", reset_password_request_path(@user), method: :put, class: "btn btn-secondary" %>
    <%= button_to "ACCOUNT LÖSCHEN", @user, method: :delete, class: "btn btn-secondary", form: {data: {turbo_confirm: "WARNUNG: Diese Aktion kann nicht rückgängig gemacht werden!"}} %>
  <% elsif is_admin? %>
    <%= button_to "Zurücksetungslink an Nutzer senden", reset_password_request_path(@user), method: :put, class: "btn btn-secondary" %>
    <%= button_to "Nutzer Löschen", @user, method: :delete, class: "btn btn-secondary", form: {data: {turbo_confirm: "WARNUNG: Diese Aktion kann nicht rückgängig gemacht werden!"}} %>
  <% end %>
</div>