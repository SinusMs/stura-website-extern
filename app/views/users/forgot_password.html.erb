<div class="section-light d-flex flex-column justify-content-center text-center form-signin m-auto mt-5" style="max-width: 320px">
    <h1>Passwort und Nutzername zurücksetzen</h1>
    <%= form_with url: forgot_password_path do |form| %>
        <div class="form-floating m-3">
            <%= form.text_field :email_address, placeholder: "", class: "form-control" %>
            <%= form.label :email_address, "E-Mail Adresse" %>
            <div class="form-text">Wenn die angegebene Adresse existiert, wird ein Zurücksetzungslink gesendet.</div>
        </div>
        <%= form.submit "Reset-Link anfordern", class: "btn btn-secondary btn-lg" %>
    <% end %>
</div>