<div class="container py-4 section-light">
  <h1>Users</h1>

  <div id="users">
    <table class="table w-auto">
        <thead>
          <th>Name</th> <th>E-Mail</th> <th>Is Admin</th> <th>Active</th> <th>Edit</th> <th>Delete</th>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.username %></td>
              <td><%= user.email_address %></td>
              <td><%= user.is_admin %></td>
              <td><%= user.reset_password_code&.is_activation_code ? false : true %></td>
              <td><%= button_to "Edit " + user.username, edit_user_path(id: user.id), method: :get, class: "btn btn-secondary btn-sm" %></td>
              <td><%= button_to "Delete " + user.username, user, method: :delete, class: "btn btn-secondary btn-sm" %></td>
            </tr>
          <% end %>
        </tbody>
    </table>
  </div>
</div>