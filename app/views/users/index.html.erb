<%= render "backend_menu" %>

<h1>Users</h1>

<div id="users">
  <% @users.each do |user| %>
    <%= render user %>
    <p>
      <%= button_to "Show " + user.username, user, method: "get" %>
      <%= button_to "Edit " + user.username, edit_user_path(id: user.id), method: "get" %>
      <%= button_to "Delete " + user.username, user, method: :delete %>
    </p>
  <% end %>
</div>


<p id="notice"><%= notice %></p>