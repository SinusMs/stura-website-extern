<p id="notice"><%= notice %></p>


<h1>Users</h1>

<%= button_to "Back to Main Page", backend_root_path, method: "get" %>
<%= button_to "New User", new_user_path, method: "get" %>
<div id="users">
  <% @users.each do |user| %>
    <%= render user %>
    <p>
      <%= button_to "Show this User", user, method: "get" %>
      <%= button_to "Edit this User", edit_user_path(id: user.id), method: "get" %>
    </p>
  <% end %>
</div>
