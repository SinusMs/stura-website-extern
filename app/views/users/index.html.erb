<h1>Users</h1>

<div id="users">
  <table>
      <thead>
        <th>Name</th> <th>Is Admin</th> <th>ID</th> <th>Show</th> <th>Edit</th> <th>Delete</th>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.username %></td>
            <td><%= user.is_admin %></td>
            <td><%= user.id %></td>
            <td><%= button_to "Show " + user.username, user, method: "get" %></td>
            <td><%= button_to "Edit " + user.username, edit_user_path(id: user.id), method: "get" %></td>
            <td><%= button_to "Delete " + user.username, user, method: :delete %></td>
          </tr>
        <% end %>
      </tbody>
  </table>
</div>