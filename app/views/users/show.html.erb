<h1>User "<%=  @user.username %>"</h1>
<%= button_to "Back to Main Page", backend_root_path, method: "get" %>
<%= render @user %>
<%= button_to "Edit this User", edit_user_path(id: @user.id), method: "get" %>
<% if is_admin? %>
    <%= button_to "Show all Users", users_path, method: "get" %>
<% end %>
